# Telegram Bot Token from @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
CLASH_API_TOKEN=eyJ...
CLASH_API_BASE_URL=https://cocproxy.royaleapi.dev/v1

OWNER_TELEGRAM_ID=123456789
TELEGRAM_GROUP_ID=-1001234567890
CLAN_TAG=#ABC123XYZ
LOG_TELEGRAM_ID=-100xxxxxxxxxx

# War polling (adaptive)
# Base / active interval while in war (also used if WAR_POLL_ACTIVE_MS unset)
WAR_POLL_INTERVAL_MS=120000
# Not in war
WAR_POLL_IDLE_MS=300000
# Optional explicit active interval (0/empty = use WAR_POLL_INTERVAL_MS)
WAR_POLL_ACTIVE_MS=
# Near battle start, 1h-left window, or war end
WAR_POLL_NEAR_MS=30000
# Floor for any adaptive interval
WAR_POLL_MIN_MS=20000

# Rate limiting
WAR_CMD_LIMIT=5
WAR_CMD_WINDOW_MS=60000
CLAN_CMD_LIMIT=8
CLAN_CMD_WINDOW_MS=60000
CWL_CMD_LIMIT=5
CWL_CMD_WINDOW_MS=60000
WAR_CACHE_TTL_MS=8000
CLASH_MAX_RETRIES=3
CLASH_API_TIMEOUT_MS=15000
TELEGRAM_MAX_RETRIES=3

# Logging
LOG_LEVEL=debug
LOG_TG_MIN_LEVEL=info
LOG_TG_MAX_PER_WINDOW=40
LOG_TG_WINDOW_MS=300000
